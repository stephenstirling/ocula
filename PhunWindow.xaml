<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ocula.PhunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ocula Phun Forum Scraper">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DragArea" Padding="16,0,150,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18"/>
                <TextBlock Text="Phun Forum Scraper" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            </StackPanel>
        </Grid>
        <Frame Grid.Row="1" x:Name="ContentFrame"/>
    </Grid>
</Window>
