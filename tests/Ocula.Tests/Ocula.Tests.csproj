    <Compile Include="..\..\Services\WindowFrame.cs" Link="App\WindowFrame.cs" />
    <Compile Include="..\..\Services\YuNetDecoder.cs" Link="App\YuNetDecoder.cs" />
    <Compile Include="..\..\Services\FaceAlignment.cs" Link="App\FaceAlignment.cs" />
    <Compile Include="..\..\Services\FaceGrouping.cs" Link="App\FaceGrouping.cs" />
    <Compile Include="..\..\Services\FaceService.cs" Link="App\FaceService.cs" />
    <Compile Include="..\..\Services\FaceModels.cs" Link="App\FaceModels.cs" />
    <Compile Include="..\..\Services\DiagnosticLog.cs" Link="App\DiagnosticLog.cs" />
