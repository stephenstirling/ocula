<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ocula.ExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export"
    PrimaryButtonText="Export"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnExportClick">

    <ScrollViewer MaxHeight="560" Padding="0,0,12,0">
        <StackPanel Spacing="14" Width="440">
            <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PresetBox" Header="Preset" HorizontalAlignment="Stretch"
                          SelectionChanged="PresetBox_SelectionChanged"/>
                <Button Grid.Column="1" Content="Save as preset" VerticalAlignment="Bottom">
                    <Button.Flyout>
                        <Flyout x:Name="SavePresetFlyout">
                            <StackPanel Spacing="8" Width="240">
                                <TextBox x:Name="PresetNameBox" Header="Preset name"/>
                                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SavePreset_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FormatBox" Header="Format" HorizontalAlignment="Stretch">
                    <x:String>JPEG</x:String>
                    <x:String>PNG</x:String>
                    <x:String>WebP</x:String>
                    <x:String>AVIF</x:String>
                    <x:String>TIFF</x:String>
                </ComboBox>
                <NumberBox Grid.Column="1" x:Name="LongEdgeBox" Header="Longest side (px)" Minimum="0" Maximum="20000"
                           SpinButtonPlacementMode="Compact" PlaceholderText="0 = original size"/>
            </Grid>

            <Slider x:Name="QualityBox" Header="Quality" Minimum="40" Maximum="100" StepFrequency="1"/>

            <ToggleSwitch x:Name="RemoveLocationBox" Header="Remove location (GPS)"/>
            <ToggleSwitch x:Name="RemoveAllBox" Header="Remove all metadata (camera details, tags…)"/>
            <ToggleSwitch x:Name="UseRawBox" Header="Use the RAW file for RAW+JPEG pairs"/>

            <TextBox x:Name="WatermarkBox" Header="Watermark" PlaceholderText="Leave empty for none"/>
            <TextBox x:Name="SuffixBox" Header="Add to file names" PlaceholderText="For example _web"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" Header="Save to" PlaceholderText="Choose a folder"/>
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
