<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ocula.PeopleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ocula.Services"
    Title="Ocula people">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="16,0,150,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragArea" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18"/>
                    <TextBlock Text="People" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" x:Name="DeleteAllButton" Content="Delete all face data" Click="DeleteAll_Click" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Groups -->
            <Grid Padding="20,8,12,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="Banner" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="People is on." Message="Faces are matched on this PC only and nothing is shared. You choose every name."/>
                <GridView Grid.Row="1" x:Name="Groups" SelectionMode="Single" SelectionChanged="Groups_SelectionChanged"
                          IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="132" Padding="8" Spacing="6" HorizontalAlignment="Center">
                                <PersonPicture Width="96" Height="96" ProfilePicture="{Binding Avatar}"/>
                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontStyle="{Binding TitleStyle}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Selected group -->
            <Border Grid.Column="1" Padding="20,8,20,16" BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel x:Name="Detail" Spacing="14" Visibility="Collapsed">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBox x:Name="NameBox" Header="Who is this?" PlaceholderText="Type a name"
                                 KeyDown="NameBox_KeyDown" TextChanged="NameBox_TextChanged"/>

                        <!-- Look up on Wikidata: only when you press the button, and only the name is sent. -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Look up on Wikidata" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="People only" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="LookupButton" Click="Lookup_Click" IsEnabled="False"
                                        ToolTipService.ToolTip="Sends only this name to Wikidata"/>
                                <ProgressRing x:Name="LookupRing" Width="18" Height="18" IsActive="False"/>
                            </StackPanel>
                            <Border x:Name="MatchBorder" Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel x:Name="MatchList" Padding="12,6"/>
                            </Border>
                            <TextBlock x:Name="LookupNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Person card -->
                        <Border x:Name="CardBorder" Visibility="Collapsed" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Person card" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <Grid x:Name="CardRows" ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <TextBlock x:Name="CardSource" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tags to add -->
                        <StackPanel x:Name="TagsPanel" Spacing="8" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Tags to add" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Written into each photo's tags" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ItemsRepeater x:Name="TagChips">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="services:TagChip">
                                        <ToggleButton Content="{x:Bind Label}" IsChecked="{x:Bind On, Mode=TwoWay}"
                                                      HorizontalAlignment="Left" CornerRadius="14" Padding="12,4"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveName_Click"/>
                        <TextBlock x:Name="SaveNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Show these photos" Click="ShowPhotos_Click"/>
                            <Button Content="Hide this group" Click="HideGroup_Click"/>
                        </StackPanel>
                        <TextBlock Text="Faces in this group" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                        <GridView x:Name="FaceGrid" SelectionMode="None" IsItemClickEnabled="False">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Image}" Width="76" Height="76" Stretch="UniformToFill"
                                           ToolTipService.ToolTip="{Binding FileName}">
                                        <Image.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Not this person" Click="NotThisPerson_Click"/>
                                            </MenuFlyout>
                                        </Image.ContextFlyout>
                                    </Image>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock Text="Right-click a face that doesn't belong and choose “Not this person”."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
