<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ocula.PeopleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ocula people">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Padding="16,0,150,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragArea" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18"/>
                    <TextBlock Text="People" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" x:Name="DeleteAllButton" Content="Delete all face data" Click="DeleteAll_Click" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Groups -->
            <Grid Padding="20,8,12,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <InfoBar x:Name="Banner" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="People is on." Message="Faces are matched on this PC only and nothing is shared. You choose every name."/>
                <GridView Grid.Row="1" x:Name="Groups" SelectionMode="Single" SelectionChanged="Groups_SelectionChanged"
                          IsItemClickEnabled="False">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="132" Padding="8" Spacing="6" HorizontalAlignment="Center">
                                <PersonPicture Width="96" Height="96" ProfilePicture="{Binding Avatar}"/>
                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           FontStyle="{Binding TitleStyle}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Selected group -->
            <Border Grid.Column="1" Padding="20,8,20,16" BorderThickness="1,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel x:Name="Detail" Spacing="14" Visibility="Collapsed">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBox x:Name="NameBox" Header="Who is this?" PlaceholderText="Type a name" KeyDown="NameBox_KeyDown"/>
                        <ToggleSwitch x:Name="TagToggle" Header="Add the name as a tag" IsOn="True"
                                      OnContent="Written into each photo's tags" OffContent="Kept in Ocula only"/>
                        <Button Content="Save name" Style="{StaticResource AccentButtonStyle}" Click="SaveName_Click"/>
                        <TextBlock x:Name="SaveNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Show these photos" Click="ShowPhotos_Click"/>
                            <Button Content="Hide this group" Click="HideGroup_Click"/>
                        </StackPanel>
                        <!-- Person card (Wikidata) -->
                        <StackPanel x:Name="CardSection" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="About this person" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="CardHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="CardRows" Spacing="6"/>
                            <TextBlock x:Name="CardCredit" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                            <HyperlinkButton x:Name="CardLink" Content="Open on Wikidata" Padding="0" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LookupButton" Content="Look up on Wikidata" Click="Lookup_Click"/>
                                <Button x:Name="RemoveCardButton" Content="Remove card" Click="RemoveCard_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="CardNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Faces in this group" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
                        <GridView x:Name="FaceGrid" SelectionMode="None" IsItemClickEnabled="False">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Image}" Width="76" Height="76" Stretch="UniformToFill"
                                           ToolTipService.ToolTip="{Binding FileName}">
                                        <Image.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Not this person" Click="NotThisPerson_Click"/>
                                            </MenuFlyout>
                                        </Image.ContextFlyout>
                                    </Image>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock Text="Right-click a face that doesn't belong and choose “Not this person”."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
