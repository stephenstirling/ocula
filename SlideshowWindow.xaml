<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ocula.SlideshowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ocula slideshow">

    <Grid x:Name="Root" Background="Black" RequestedTheme="Dark" PointerMoved="Root_PointerMoved"
          KeyDown="Root_KeyDown" IsTabStop="True">
        <!-- Two images cross-fade into each other. -->
        <Image x:Name="ImageA" Stretch="Uniform" Opacity="1"/>
        <Image x:Name="ImageB" Stretch="Uniform" Opacity="0"/>

        <TextBlock x:Name="CaptionText" Margin="32" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Foreground="#DDFFFFFF" FontSize="16" Visibility="Collapsed"/>

        <!-- Controls appear when the mouse moves, and fade after a few seconds. -->
        <Border x:Name="Controls" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Padding="10,6" CornerRadius="12" Background="#CC1C1C1F">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Click="Previous_Click" ToolTipService.ToolTip="Previous (←)" AutomationProperties.Name="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="14"/>
                </Button>
                <Button x:Name="PlayButton" Click="Play_Click" ToolTipService.ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="14"/>
                </Button>
                <Button Click="Next_Click" ToolTipService.ToolTip="Next (→)" AutomationProperties.Name="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                </Button>
                <ComboBox x:Name="IntervalBox" SelectedIndex="1" SelectionChanged="Interval_Changed" VerticalAlignment="Center"
                          AutomationProperties.Name="Time per photo">
                    <x:String>3 seconds</x:String>
                    <x:String>5 seconds</x:String>
                    <x:String>8 seconds</x:String>
                    <x:String>15 seconds</x:String>
                </ComboBox>
                <ToggleButton x:Name="ShuffleToggle" ToolTipService.ToolTip="Shuffle" AutomationProperties.Name="Shuffle" Click="Shuffle_Click">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="CaptionToggle" ToolTipService.ToolTip="Show names (I)" AutomationProperties.Name="Show names" Click="Caption_Click">
                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                </ToggleButton>
                <TextBlock x:Name="PositionText" VerticalAlignment="Center" Margin="8,0" Foreground="#B3FFFFFF"/>
                <Button Click="Close_Click" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
