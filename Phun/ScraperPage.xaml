<?xml version="1.0" encoding="utf-8"?>
<!-- Ocula "Phun" tab: live view of the scraper container.
     Add Assets/phun-logo.png to the project (Build Action: Content). -->
<Page
    x:Class="Ocula.Views.ScraperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lib="using:Ocula.Library"
    xmlns:local="using:Ocula.Views">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Header: logo on a fixed dark-blue chip so the white wordmark reads in light and dark themes -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#1B4F82" CornerRadius="8" Padding="14,8">
                    <Image Source="ms-appx:///Assets/phun-logo.png" Height="34"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="SubText" Opacity="0.7"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="ScanNowButton" Content="Scan now"
                        Style="{StaticResource AccentButtonStyle}" Click="ScanNow_Click"
                        VerticalAlignment="Center"/>
            </Grid>

            <InfoBar x:Name="OfflineBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="Scraper offline"
                     Message="No recent update from the container. Check that it is running in Container Manager."/>
            <InfoBar x:Name="ErrorBar" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="Last scan problem"/>
            <InfoBar x:Name="TagBar" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="Some images were saved without their tags"/>

            <!-- Progress -->
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="This scan" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScanCountText" HorizontalAlignment="Right" Opacity="0.7"/>
                </Grid>
                <ProgressBar x:Name="ScanBar" Maximum="100"/>

                <TextBlock x:Name="ThreadText" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                <Grid>
                    <TextBlock Text="Images in this thread" Opacity="0.7"/>
                    <TextBlock x:Name="LinkCountText" HorizontalAlignment="Right" Opacity="0.7"/>
                </Grid>
                <ProgressBar x:Name="LinkBar" Maximum="100"/>
            </StackPanel>

            <!-- Counters (since the container last started) -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatCard}"><StackPanel>
                    <TextBlock x:Name="SavedText" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Saved" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}"><StackPanel>
                    <TextBlock x:Name="UpgradedText" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Upgraded" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource StatCard}"><StackPanel>
                    <TextBlock x:Name="DupText" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Duplicates" Opacity="0.7"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource StatCard}"><StackPanel>
                    <TextBlock x:Name="FailedText" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Failed" Opacity="0.7"/></StackPanel></Border>
            </Grid>

            <!-- Recently saved pictures, from the scraper's library file -->
            <Grid>
                <TextBlock Text="Recently saved" FontWeight="SemiBold"/>
                <TextBlock x:Name="RecentNote" HorizontalAlignment="Right" Opacity="0.7"/>
            </Grid>
            <GridView x:Name="RecentGrid" SelectionMode="Single" SelectionChanged="RecentGrid_SelectionChanged" MaxHeight="440"
                      AutomationProperties.Name="Recently saved pictures">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:RecentImage">
                        <StackPanel Width="132" Spacing="4" Padding="4">
                            <Grid Width="124" Height="94" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill"/>
                                <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" Padding="6,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                    <TextBlock Text="{x:Bind Badge}" FontSize="11"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Border x:Name="DetailCard" Style="{StaticResource StatCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DetailName" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailMeta" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock Text="Tags in the file" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DetailTags" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <InfoBar x:Name="DetailTagWarning" Severity="Warning" IsOpen="False" IsClosable="False"
                             Title="Some tags are missing from the file"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open in Ocula" Click="OpenInOcula_Click"/>
                        <Button Content="Show in folder" Click="ShowInFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Activity log -->
            <TextBlock Text="Recent activity" FontWeight="SemiBold"/>
            <Border Style="{StaticResource StatCard}" Padding="0">
                <ListView x:Name="EventList" MaxHeight="320" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lib:ScraperEvent">
                            <TextBlock Text="{x:Bind Message}" FontFamily="Consolas" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Page>
