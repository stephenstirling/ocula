<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Research tool, not part of the app. Lists the portable devices (cameras, phones) connected over USB with
    the Windows Portable Devices (WPD) COM API, and prints what each reports: manufacturer, model, firmware
    version and serial number. It also lists what WinRT can see, and USB drives (cameras in mass-storage mode).
    Usage and results: see README.md and docs/CAMERA-FIRMWARE.md.
  -->
  <PropertyGroup>
    <!-- Windows TFM so the WinRT device enumeration APIs are available. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>
</Project>
