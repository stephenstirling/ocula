<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Measures People on real photos: how many faces YuNet finds (with the boxes drawn on), and how well
    SFace's embeddings group into people at different thresholds. Shares the app's own face code
    (linked below), so it measures exactly what Ocula does. Usage: see README.md next to this file.
  -->
  <PropertyGroup>
    <!-- Windows TFM for StorageFile thumbnails, which is what the app analyses. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- FaceServiceSource lets an experiment swap in a modified copy of FaceService.cs. -->
    <FaceServiceSource Condition="'$(FaceServiceSource)' == ''">..\..\Services\FaceService.cs</FaceServiceSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(FaceServiceSource)" Link="App\FaceService.cs" />
    <Compile Include="..\..\Services\FaceModels.cs" Link="App\FaceModels.cs" />
    <Compile Include="..\..\Services\DiagnosticLog.cs" Link="App\DiagnosticLog.cs" />
    <Compile Include="..\..\Services\SmartModels.cs" Link="App\SmartModels.cs" />
    <Compile Include="..\..\Services\YuNetDecoder.cs" Link="App\YuNetDecoder.cs" />
    <Compile Include="..\..\Services\FaceAlignment.cs" Link="App\FaceAlignment.cs" />
    <Compile Include="..\..\Services\FaceGrouping.cs" Link="App\FaceGrouping.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
</Project>
