<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Ocula</RootNamespace>
    <AssemblyName>Ocula</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only: VLC's engine has no ARM64 build, and the ONNX models are tested on x64. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Always build for win-x64 so native DLLs (Win2D, Magick, SQLite, ONNX) land next to Ocula.exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs owns Main so a second launch is redirected to the running window. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- The icon and publisher details shown for Ocula.exe (File Explorer > Properties > Details). -->
  <PropertyGroup>
    <Product>Ocula</Product>
    <Company>Stephen Stirling</Company>
    <Authors>Stephen Stirling</Authors>
    <Copyright>© 2026 Stephen Stirling</Copyright>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not part of the app: the C++ shell extension, the spare icon folder and design docs. -->
    <Compile Remove="OculaShell\**;Ocula-Assets\**;docs\**" />
    <None Remove="OculaShell\**;Ocula-Assets\**;docs\**" />
    <Page Remove="OculaShell\**;Ocula-Assets\**;docs\**" />
    <Content Include="Assets\**" Exclude="Assets\AppIcon*.svg" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="LibVLCSharp.WinUI" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="CoenM.ImageSharp.ImageHash" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!--
    OculaShell (the C++ "Open in Ocula" folder menu DLL) is built first and packaged with the app.
    C++ projects only build under Visual Studio's MSBuild (msbuild / F5), not `dotnet build`,
    so the reference is skipped there and a warning says the DLL isn't in that build.
  -->
  <PropertyGroup>
    <OculaShellOutDir>$(StirlingLocalBuildRoot)OculaShell\bin\$(Platform)\$(Configuration)\</OculaShellOutDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
    <ProjectReference Include="OculaShell\OculaShell.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(OculaShellOutDir)OculaShell.dll" Condition="'$(MSBuildRuntimeType)' == 'Full' or Exists('$(OculaShellOutDir)OculaShell.dll')">
      <Link>OculaShell.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="WarnMissingOculaShell" BeforeTargets="Build"
          Condition="'$(MSBuildRuntimeType)' != 'Full' and !Exists('$(OculaShellOutDir)OculaShell.dll')">
    <Warning Text="OculaShell.dll isn't built by 'dotnet build' (C++). Build with msbuild or Visual Studio to include the 'Open in Ocula' folder menu." />
  </Target>

  <!-- Enables the Package and Publish context menu in Visual Studio Solution Explorer. -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
