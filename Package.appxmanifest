<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 com rescap virtualization">

  <!-- Placeholder identity: replace via Project > Publish > Associate App with the Store. -->
  <Identity
    Name="StephenStirling.Ocula"
    Publisher="CN=StephenStirling"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Ocula</DisplayName>
    <PublisherDisplayName>Stephen Stirling</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Windows redirects a packaged app's writes under %LocalAppData% into its private package folder. This folder is the exception:
         "Share people with Porta" writes %LocalAppData%\Stirling\Ocula\people-index.json (and people-thumbs) where Porta can read it. -->
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\Stirling</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 (the Windows App SDK's minimum) and later. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Ocula"
        Description="A fast, private photo browser."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Open with" for these images; Ocula can be the default app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="oculaimages">
            <uap:DisplayName>Image</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.jxr</uap:FileType>
              <uap:FileType>.psd</uap:FileType>
              <uap:FileType>.cr2</uap:FileType>
              <uap:FileType>.cr3</uap:FileType>
              <uap:FileType>.nef</uap:FileType>
              <uap:FileType>.arw</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.orf</uap:FileType>
              <uap:FileType>.rw2</uap:FileType>
              <uap:FileType>.raf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- ocula: links from Capta (Services/OculaLink.cs). Capta treats Ocula as installed only
             while this scheme is registered. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="ocula">
            <uap:DisplayName>Ocula</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- ocula "D:\Photos" from a terminal or Win+R. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Ocula.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ocula.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!-- "Open in Ocula" on folders. The Clsid matches OculaShell\dllmain.cpp. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenInOcula" Clsid="6B1F2C3A-8D4E-4F7A-9C2B-5E3D1A7F9B42" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Ocula folder menu">
              <com:Class Id="6B1F2C3A-8D4E-4F7A-9C2B-5E3D1A7F9B42" Path="OculaShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Needed for the excluded folder above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
